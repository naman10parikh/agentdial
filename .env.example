# agentdial — Environment Variables (placeholders only — copy to .env and fill in)
#
# .env is gitignored. NEVER commit real secrets.
# Per-channel credentials set via `agentdial setup` are stored in ~/.agentdial/credentials/*.json
# (dir chmod 0700, files chmod 0600) — outside this repo. These env vars are the
# optional "master account" / fallback path for provisioning and the built-in agent.

# --- LLM (the built-in agent brain) ---
# Anthropic Claude. Get at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional OpenAI fallback for the built-in agent.
# OPENAI_API_KEY=sk-...

# --- Twilio (SMS / WhatsApp / Voice) ---
# Master account used for auto-provisioning subaccounts + numbers.
# Get at: https://console.twilio.com (Account SID + Auth Token on dashboard)
# TWILIO_MASTER_SID=AC...
# TWILIO_MASTER_TOKEN=...
# Single-account mode (no provisioning) instead of master:
# TWILIO_ACCOUNT_SID=AC...
# Advanced: override API base / channel list (rarely needed)
# TWILIO_API_BASE=https://api.twilio.com
# TWILIO_CHANNELS=sms,whatsapp,voice

# --- Email ---
# AgentMail (agent-native inboxes). Get at: https://agentmail.to
# AGENTMAIL_API_KEY=...
# SendGrid (transactional email). Get at: https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=SG...

# --- Chat platforms ---
# Slack bot token. Get at: https://api.slack.com/apps → OAuth & Permissions
# SLACK_BOT_TOKEN=xoxb-...
# Discord bot token. Get at: https://discord.com/developers/applications
# DISCORD_BOT_TOKEN=...
# Telegram bot token. Get from @BotFather on Telegram.
# TELEGRAM_BOT_TOKEN=...

# --- Voice ---
# VAPI (voice agents). Get at: https://dashboard.vapi.ai
# VAPI_API_KEY=...

# --- Server ---
# Port the local gateway / webhook server binds to (default 3000).
# PORT=3000
